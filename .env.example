# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* vars reach the app bundle — never put secrets here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://api.example.com/v1
# true = all API calls are answered by src/mocks (no backend needed)
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_MOCK_LATENCY_MS=600
